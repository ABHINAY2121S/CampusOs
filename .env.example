# Copy to .env and fill in values before running docker compose up

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=campusos
DB_PASSWORD=campusos
DB_NAME=campusos
# Set automatically by docker-compose for the backend container:
DATABASE_URL=postgresql://campusos:campusos@db:5432/campusos
# For local prisma commands (outside Docker), point to localhost:
# DATABASE_URL=postgresql://campusos:campusos@localhost:5432/campusos

# ── Auth ───────────────────────────────────────────────────────────────────
# At least 32 random chars. Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d

# ── Backend ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── NLP service (optional) ────────────────────────────────────────────────
NLP_SERVICE_URL=http://nlp-service:8001
# For local backend dev (outside Docker):
# NLP_SERVICE_URL=http://localhost:8001

# ── LLM – Ollama (fully optional, never required) ─────────────────────────
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
