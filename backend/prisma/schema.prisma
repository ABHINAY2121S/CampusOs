generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  student
  faculty
  hod
  admin
  technician
}

enum IssueStatus {
  reported
  ai_classified
  assigned
  technician_accepted
  in_progress
  resolved
  closed
}

// ── Core entities ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  /// For technician: their home department; for students/faculty: college dept label
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  studentId    String?
  year         String?
  division     String?
  createdAt    DateTime           @default(now())

  reportedIssues    Issue[]             @relation("reporter")
  assignedIssues    Issue[]             @relation("assignee")
  affected          IssueAffected[]
  follows           IssueFollow[]
  comments          Comment[]
  notifications     Notification[]
  savedSchemes      SavedItem[]
  registrations     EventRegistration[]
  lostFoundItems    LostFoundItem[]
}

model Department {
  id     String  @id @default(cuid())
  name   String  @unique
  code   String  @unique
  users  User[]
  issues Issue[]
}

model Building {
  id    String @id @default(cuid())
  name  String @unique
  code  String @unique
  rooms Room[]
}

model Room {
  id         String   @id @default(cuid())
  code       String
  name       String
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  @@unique([buildingId, code])
}

// ── Issue cluster (duplicate grouping) ────────────────────────────────────

model IssueCluster {
  id               String  @id @default(cuid())
  canonicalIssueId String  @unique
  affectedCount    Int     @default(1)
  /// Distinct merged reports (used by priority engine duplicate factor)
  mergedCount      Int     @default(1)
  issues           Issue[]
}

// ── Issue ──────────────────────────────────────────────────────────────────

model Issue {
  id                String      @id @default(cuid())
  displayId         String      @unique  // e.g. CO-2041
  title             String
  description       String
  category          String
  building          String?
  room              String?
  asset             String?
  urgency           String?     // low | medium | high | critical | emergency
  status            IssueStatus @default(reported)
  priorityScore     Int         @default(0)
  /// { affected, severity, duration, location, academic, duplicate } contributions
  priorityBreakdown Json?
  clusterId         String?
  cluster           IssueCluster? @relation(fields: [clusterId], references: [id])
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id])
  assigneeId        String?
  assignee          User?         @relation("assignee", fields: [assigneeId], references: [id])
  reporterId        String
  reporter          User          @relation("reporter", fields: [reporterId], references: [id])
  /// 384-dim sentence-transformers embedding (pgvector)
  embedding         Unsupported("vector(384)")?
  affectedUsers     IssueAffected[]
  followers         IssueFollow[]
  events            IssueEvent[]
  comments          Comment[]
  attachments       Attachment[]
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?
}

model IssueAffected {
  issueId String
  userId  String
  issue   Issue  @relation(fields: [issueId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@id([issueId, userId])
}

model IssueFollow {
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([issueId, userId])
}

model IssueEvent {
  id        String   @id @default(cuid())
  issueId   String
  actor     String   // display name or "system"
  type      String   // created | status_changed | assigned | merged | commented | resolved
  payload   Json?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Attachment {
  id        String @id @default(cuid())
  issueId   String
  filename  String
  url       String
  sizeBytes Int
  issue     Issue  @relation(fields: [issueId], references: [id])
}

// ── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // issue_update | new_notice | event_reminder | system
  title     String
  body      String
  payload   Json?    // { issueId?, noticeId?, eventId? }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ── Secondary modules ──────────────────────────────────────────────────────

model Notice {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String
  important   Boolean  @default(false)
  publishedAt DateTime @default(now())
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String
  date          DateTime
  venue         String
  category      String
  registrations EventRegistration[]
}

model EventRegistration {
  eventId   String
  userId    String
  event     Event  @relation(fields: [eventId], references: [id])
  user      User   @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
}

model LostFoundItem {
  id          String   @id @default(cuid())
  type        String   // lost | found
  title       String
  description String
  location    String
  reporterId  String
  status      String   @default("open")  // open | matched | closed
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime @default(now())
  reporter    User     @relation(fields: [reporterId], references: [id])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  description String
  category    String
  url         String?
  icon        String?
}

model Scheme {
  id          String    @id @default(cuid())
  title       String
  description String
  eligibility String
  deadline    DateTime?
  embedding   Unsupported("vector(384)")?
  savedBy     SavedItem[]
}

model SavedItem {
  userId   String
  schemeId String
  user     User   @relation(fields: [userId], references: [id])
  scheme   Scheme @relation(fields: [schemeId], references: [id])

  @@id([userId, schemeId])
}
